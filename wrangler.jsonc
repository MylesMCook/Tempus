{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tempus",
  "main": "src/worker.tsx",
  "compatibility_flags": ["nodejs_compat"],
  "compatibility_date": "2026-03-29",
  "preview_urls": false,
  "workers_dev": true,
  "routes": [{ "pattern": "tempus.funnydomainname.com", "custom_domain": true }],
  "limits": { "cpu_ms": 100 },
  "ratelimits": [
    {
      "name": "PARSE_RATE_LIMITER",
      "namespace_id": "2026091201",
      "simple": { "limit": 120, "period": 60 },
    },
  ],
  "assets": {
    "binding": "ASSETS",
  },
  "observability": {
    "enabled": true,
    "redact_query_string": true,
  },
}
