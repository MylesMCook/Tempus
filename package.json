  "scripts": {
    "dev": "vp dev",
    "build": "tsc -b && vp build",
    "check": "pnpm build:sdk && vp check",
    "test": "vp test",
    "compare": "vp test run comparison",
    "preview": "vp preview",
    "prepare": "vp config",
    "deploy": "pnpm check && pnpm test && pnpm build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "build:sdk": "tsc -p tsconfig.sdk.json && node -e \"require('node:fs').copyFileSync('src/shared/date-engine/timezone-LICENSE.txt', 'packages/core/dist/date-engine/timezone-LICENSE.txt')\"",
