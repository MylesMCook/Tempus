{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tempus-total",
  "main": "worker/legacy-redirect.ts",
  "compatibility_date": "2026-03-29",
  "workers_dev": true,
  "preview_urls": false,
  "routes": [{ "pattern": "tempus-total.funnydomainname.com", "custom_domain": true }],
  "limits": { "cpu_ms": 100 },
  "services": [{ "binding": "TEMPUS", "service": "tempus" }],
  "observability": { "enabled": true, "redact_query_string": true },
}
